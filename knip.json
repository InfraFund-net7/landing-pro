{
  "entry": [
    "pages/**/*.{ts,tsx}",
    "app/**/*.{ts,tsx}",
    "src/**/*.{ts,tsx}",
    "index.{ts,tsx}"
  ],
  "project": ["**/*.{ts,tsx,js,jsx}"],
  "ignore": [
    "node_modules/**",
    ".next/**",
    "build/**",
    "public/**",
    "coverage/**",
    "*.config.*",
    "next-env.d.ts"
  ],
  "ignoreDependencies": [
    "next",
    "react",
    "react-dom",
    "@types/*"
  ],
  "plugins": ["next", "typescript"]
}