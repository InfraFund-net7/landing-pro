{
  "name": "landing-infrafund",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next",
    "dev": "next dev",
    "dev:clean": "npm run clean && next dev",
    "build": "npm run generate:importmap && next build",
    "start": "next start",
    "build-start": "npm run build && npm run start",
    "format": "npm run format:lint && npm run format:prettier && npm run format:cspell && npm run format:knip",
    "format:lint": "eslint",
    "format:prettier": "prettier . --check",
    "format:cspell": "cspell",
    "format:knip": "knip",
    "fix:prettier": "prettier --write .",
    "fix:lint": "eslint --fix .",
    "postinstall": "patch-package",
    "prepare": "husky",
    "generate:importmap": "node --env-file-if-exists=.env.local --env-file-if-exists=.env src/scripts/generate-importmap.mjs",
    "generate:types": "payload generate:types",
    "payload": "payload --disable-transpile",
    "seed:home-page": "node --env-file=.env.local src/scripts/seed-home-page.mjs",
    "seed:site-pages": "node --env-file=.env.local src/scripts/seed-site-pages.mjs",
    "seed:posts": "node --env-file=.env.local src/scripts/seed-posts.mjs",
    "seed:all": "node --env-file=.env.local --env-file-if-exists=.env src/scripts/seed-all.mjs",
    "promote:master-admin": "node --env-file=.env.local src/scripts/promote-master-admin.mjs",
    "db:migrate:users-role": "node --env-file=.env.local src/scripts/migrate-users-role.mjs",
    "db:migrate:user-profile": "node --env-file=.env.local src/scripts/migrate-user-profile.mjs",
    "db:migrate:posts-categories": "node --env-file=.env.local src/scripts/migrate-posts-categories-to-text.mjs",
    "db:bootstrap:payload": "node --env-file=.env.local --env-file-if-exists=.env src/scripts/bootstrap-payload-schema.mjs",
    "db:create-payload-admin": "node src/scripts/create-payload-first-user.mjs",
    "db:create-payload-master-admin": "node src/scripts/create-payload-master-admin.mjs",
    "db:test-payload-email": "node src/scripts/test-payload-email.mjs",
    "db:verify-payload-users": "node src/scripts/verify-payload-users.mjs",
    "db:verify-payload-login": "node src/scripts/verify-payload-login.mjs",
    "db:migrate:backpro-neon": "node --env-file=.env.local src/scripts/migrate-backpro-to-neon.mjs"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@neondatabase/serverless": "^1.1.0",
    "@payloadcms/db-postgres": "^3.84.1",
    "@payloadcms/email-nodemailer": "^3.84.1",
    "@payloadcms/next": "^3.84.1",
    "@payloadcms/richtext-lexical": "^3.84.1",
    "@payloadcms/storage-vercel-blob": "^3.84.1",
    "@payloadcms/ui": "^3.84.1",
    "@tiptap/core": "3.25.0",
    "@tiptap/extension-color": "^3.25.0",
    "@tiptap/extension-image": "^3.25.0",
    "@tiptap/extension-link": "^3.25.0",
    "@tiptap/extension-placeholder": "^3.25.0",
    "@tiptap/extension-text-align": "^3.25.0",
    "@tiptap/extension-text-style": "^3.25.0",
    "@tiptap/extension-underline": "^3.25.0",
    "@tiptap/pm": "^3.25.0",
    "@tiptap/react": "^3.25.0",
    "@tiptap/starter-kit": "^3.25.0",
    "axios": "^1.13.2",
    "bufferutil": "^4.1.0",
    "graphql": "^16.13.2",
    "gsap": "^3.13.0",
    "lucide-react": "^0.542.0",
    "next": "15.5.7",
    "nodemailer": "^8.0.7",
    "payload": "^3.84.1",
    "pg": "^8.21.0",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "react-is": "19.1.2",
    "react-responsive": "^10.0.1",
    "recharts": "^3.3.0",
    "sass": "^1.99.0",
    "sharp": "^0.34.5",
    "ws": "^8.20.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "cspell": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.7",
    "husky": "^9.1.7",
    "knip": "^5.66.2",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
