# Backpro → Neon migration (waitlist, contact forms, non-resident waitlist, countries, auth tables):
#   SOURCE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/infra_dev?sslmode=disable
#   TARGET_DATABASE_URL=<Neon unpooled URL, same DB as DATABASE_URL below>
#   node src/scripts/migrate-backpro-to-neon.mjs
#
# Payload CMS (Postgres — prefer a dedicated DATABASE_URL; if you share a server, Payload uses schema `payload`)
# PAYLOAD_SECRET=generate-a-long-random-string-at-least-32-chars
# Or Docker Compose `secrets:` (mounted under /run/secrets/<name>): names `payload_secret` and `database_url`
# are read automatically; otherwise set PAYLOAD_SECRET_FILE / DATABASE_URL_FILE to the mount path.
# Payload does NOT read POSTGRES_USER / POSTGRES_PASSWORD — you must set DATABASE_URL (one line).
# In Docker Compose, use the DB *service name* as host (e.g. postgres:5432), not 127.0.0.1 — from inside
# the landing container, localhost is the landing app itself, not the sibling Postgres container.
# Replace 127.0.0.1 only when Postgres runs on the same host as the Node process (local bare metal).
# DATABASE_URL=postgresql://admin:YOUR_PASSWORD@postgres:5432/landing_payload
# Vercel / Neon (Preview beta.infrafund.net or Production):
# DATABASE_URL=postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# After pointing at Neon, bootstrap Payload CMS tables once:
#   DATABASE_URL='postgresql://...@....neon.tech/neondb?sslmode=require' npm run db:bootstrap:payload
# Dev: avoids parallel Next inits skipping Drizzle push before tables exist (admin "users does not exist").
# Set explicitly if you do not use src/instrumentation.ts, or override with "false" to opt out.
# PAYLOAD_FORCE_DRIZZLE_PUSH=true
# Public origin for Payload (forgot-password links, admin). Required for valid reset URLs.
# Local: http://localhost:3000  Production: https://infrafund.net (no trailing path)
# PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Payload admin email (forgot password, etc.) — same vars as backpro contact form / waitlist.
# If any of HOST, PORT, SENDER, PASSWORD is missing, Payload logs emails to the console instead.
# INFRA_CONTACT_FORM_SMTP_HOST=
# INFRA_CONTACT_FORM_SMTP_PORT=
# INFRA_CONTACT_FORM_SMTP_SENDER=
# INFRA_CONTACT_FORM_SMTP_USERNAME=
# INFRA_CONTACT_FORM_SMTP_PASSWORD=
# INFRA_CONTACT_FORM_SMTP_REQUIRE_TLS=false
# Optional display name in From header (default: InfraFund)
# INFRA_CONTACT_FORM_SMTP_FROM_NAME=
# Optional: gate CMS page replacement by route-level fallback pages.
# Enable only after site-pages content fully matches handcrafted pages.
# CMS_REPLACE_EXISTING_PAGES=false

# API (backend)
# NEXT_PUBLIC_API_BASE_URL=https://api-dev.infrafund.net/v1

# Dashboard login (header "Login" → full URL). Used when not in relative auth mode.
# Local (direct to dash on another port): http://localhost:3001/login
# Dev: https://dash-dev.infrafund.net/login
NEXT_PUBLIC_DASH_LOGIN_URL=https://dashboard.infrafund.net/login

# Optional: explicit sign-up URL after the landing survey (OpenFort on dash).
# If unset, /login in NEXT_PUBLIC_DASH_LOGIN_URL is replaced with /register at runtime.
# NEXT_PUBLIC_DASH_REGISTER_URL=https://dashboard.infrafund.net/register

# Same-origin OpenFort handoff (localhost only): Login → /login, survey → /register on this app
# (e.g. localhost:3000), proxied to the dashboard. On infrafund.net production, Login always goes to
# https://dashboard.infrafund.net/login regardless of this flag.
# NEXT_PUBLIC_DASH_AUTH_MODE=relative
# DASHBOARD_PROXY_ORIGIN=http://localhost:3001
# (alias: DASHBOARD_DEV_PROXY_ORIGIN)
# Proxies /login, /register, and /sign-out to the dashboard app when relative auth mode is on.

# Optional: explicit dashboard sign-out URL (defaults from NEXT_PUBLIC_DASH_LOGIN_URL → /sign-out).
# NEXT_PUBLIC_DASH_SIGN_OUT_URL=https://dashboard.infrafund.net/sign-out

# Deploy:
#   main    → Vercel Production (link repo in Vercel; Production Branch = main). See docs/deploy-vercel.md
#   develop → optional Docker on VM (deploy-dev.yaml) and/or Vercel Preview. See docs/deploy-self-hosted.md

# Parent domain so survey_data is readable on dash (and any *.infrafund.net).
# Omit when developing only on http://localhost (browser will not set cross-site Domain).
NEXT_PUBLIC_SURVEY_COOKIE_DOMAIN=.infrafund.net

# reCAPTCHA (see your Google reCAPTCHA console)
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
