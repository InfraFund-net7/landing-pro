# Payload CMS (Postgres — prefer a dedicated DATABASE_URL; if you share a server, Payload uses schema `payload`)
# PAYLOAD_SECRET=generate-a-long-random-string-at-least-32-chars
# Payload does NOT read POSTGRES_USER / POSTGRES_PASSWORD — you must set DATABASE_URL (one line).
# In Docker Compose, use the DB *service name* as host (e.g. postgres:5432), not 127.0.0.1 — from inside
# the landing container, localhost is the landing app itself, not the sibling Postgres container.
# Replace 127.0.0.1 only when Postgres runs on the same host as the Node process (local bare metal).
# DATABASE_URL=postgresql://admin:YOUR_PASSWORD@postgres:5432/landing_payload
# If DATABASE_URL points at an existing DB (shared with other apps), create the Payload schema once:
#   psql "$DATABASE_URL" -c 'CREATE SCHEMA IF NOT EXISTS payload;'
# Dev: avoids parallel Next inits skipping Drizzle push before tables exist (admin "users does not exist").
# Set explicitly if you do not use src/instrumentation.ts, or override with "false" to opt out.
# PAYLOAD_FORCE_DRIZZLE_PUSH=true
# Optional: public site URL for admin links and media (no path)
# PAYLOAD_PUBLIC_SERVER_URL=https://www.example.com

# API (backend)
# NEXT_PUBLIC_API_BASE_URL=https://api-dev.infrafund.net/v1

# Dashboard login (header "Login" → full URL). Used when not in relative auth mode.
# Local (direct to dash on another port): http://localhost:3001/login
NEXT_PUBLIC_DASH_LOGIN_URL=https://dash-dev.infrafund.net/login

# Optional: explicit sign-up URL after the landing survey (OpenFort on dash).
# If unset, /login in NEXT_PUBLIC_DASH_LOGIN_URL is replaced with /register at runtime.
# NEXT_PUBLIC_DASH_REGISTER_URL=https://dash-dev.infrafund.net/register

# Same-origin OpenFort handoff (recommended local): Login → /login, survey → /register on this app
# (e.g. localhost:3000), proxied to the dashboard. OpenFort + JWT/session run on the dash app before
# its client-side redirects, same as opening the dashboard login page directly.
# NEXT_PUBLIC_DASH_AUTH_MODE=relative
# DASHBOARD_PROXY_ORIGIN=http://localhost:3001
# (alias: DASHBOARD_DEV_PROXY_ORIGIN)

# Parent domain so survey_data is readable on dash (and any *.infrafund.net).
# Omit when developing only on http://localhost (browser will not set cross-site Domain).
NEXT_PUBLIC_SURVEY_COOKIE_DOMAIN=.infrafund.net

# reCAPTCHA (see your Google reCAPTCHA console)
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
